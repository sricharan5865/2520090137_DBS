# Application Settings
PROJECT_NAME="Smart Chronic Kidney Disease Risk Prediction and Patient Management System"
VERSION="1.0.0"
API_PREFIX="/api"

# JWT Security
SECRET_KEY="generate_a_secure_random_32_character_hex_or_base64_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Domain Configuration
# Comma-separated list of allowed origins or "*"
ALLOWED_ORIGINS="*"

# PostgreSQL Relational Database (Defaults to local SQLite fallback if not set)
DATABASE_URL="postgresql://ckd_admin:ckd_secure_password_2026@localhost:5432/ckd_healthcare_db"
# Fallback SQLite: DATABASE_URL="sqlite:///./ckd_healthcare.db"

# MongoDB Integration (Optional for semi-structured clinical documents)
ENABLE_MONGODB=false
MONGODB_URL="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="ckd_healthcare_docs"
